{
  "mouse_wheel_zoom": true,
  "icon_theme": "Material Icon Theme",
  "remove_trailing_whitespace_on_save": false,
  "ensure_final_newline_on_save": false,
  "helix_mode": true,
  "git": {
    "inline_blame": {
      "enabled": false,
    },
  },
  "proxy": "",
  "buffer_line_height": "comfortable",
  "buffer_font_family": "Droid Sans Mono",
  "outline_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "git_panel": {
    "dock": "left",
  },
  "auto_install_extensions": {
    "catppuccin": true,
    "git-firefly": true,
    "material-icon-theme": true,
    "toml": true,
  },
  "buffer_font_size": 18,
  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "cursor_blink": false,
  "cursor_shape": "block",
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/__pycache__",
    "**/.ruff_cache",
  ],
  "file_types": {
    "Git Attributes": ["**/{git,.git,.git/info}/attributes"],
    "Git Config": [
      "*.gitconfig",
      "**/{git,.git/modules,.git/modules/*}/config",
    ],
    "Git Ignore": ["**/{git,.git}/ignore", "**/.git/info/exclude"],
  },
  "gutter": {
    "bookmarks": false,
    "folds": false,
  },
  "journal": {
    "hour_format": "hour24",
  },
  "project_panel": {
    "auto_reveal_entries": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "show_edit_predictions": false,
  "status_bar": {
    "cursor_position_button": false,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "font_weight": 400.0,
    "env": {
      "GIT_EDITOR": "zed --wait",
    },
    "font_family": "MesloLGM Nerd Font",
    "font_size": 18.0,
  },
  "theme": "Catppuccin Mocha",
  "title_bar": {
    "show_onboarding_banner": false,
    "show_user_picture": false,
    "show_sign_in": false,
  },
}
